<Window x:Class="DndAssistant.ItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор предмета" Height="500" Width="600" Background="#F0F0F0"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Common properties -->
                <TextBlock Text="Общие свойства" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>
                
                <TextBlock Text="Название:" FontWeight="Bold"/>
                <TextBox Text="{Binding ItemName, Mode=TwoWay}" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Описание:" FontWeight="Bold"/>
                <TextBox Text="{Binding Description, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" Height="80" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Вес:" FontWeight="Bold"/>
                <TextBox Text="{Binding Weight, Mode=TwoWay}" Padding="5" Margin="0,0,0,15"/>

                <!-- Weapon properties -->
                <StackPanel Visibility="{Binding IsWeapon, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Свойства оружия" FontSize="14" FontWeight="Bold" Foreground="#E67E22" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Урон:" FontWeight="Bold"/>
                    <TextBox Text="{Binding Damage, Mode=TwoWay}" Padding="5" Margin="0,0,0,10"/>

                    <TextBlock Text="Тип урона:" FontWeight="Bold"/>
                    <TextBox Text="{Binding DamageType, Mode=TwoWay}" Padding="5" Margin="0,0,0,10"/>

                    <TextBlock Text="Тип оружия:" FontWeight="Bold"/>
                    <TextBox Text="{Binding WeaponType, Mode=TwoWay}" Padding="5" Margin="0,0,0,10"/>

                    <CheckBox Content="Магическое" IsChecked="{Binding IsMagical, Mode=TwoWay}" Margin="0,0,0,10"/>

                    <TextBlock Text="Магический бонус:" FontWeight="Bold"/>
                    <TextBox Text="{Binding MagicalBonus, Mode=TwoWay}" Padding="5" Margin="0,0,0,15"/>
                </StackPanel>

                <!-- Armor properties -->
                <StackPanel Visibility="{Binding IsArmor, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Свойства брони" FontSize="14" FontWeight="Bold" Foreground="#2ECC71" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Класс доспеха:" FontWeight="Bold"/>
                    <TextBox Text="{Binding ArmorClass, Mode=TwoWay}" Padding="5" Margin="0,0,0,10"/>

                    <TextBlock Text="Тип брони:" FontWeight="Bold"/>
                    <TextBox Text="{Binding ArmorType, Mode=TwoWay}" Padding="5" Margin="0,0,0,10"/>

                    <CheckBox Content="Магическая" IsChecked="{Binding IsMagical, Mode=TwoWay}" Margin="0,0,0,10"/>

                    <TextBlock Text="Магический бонус:" FontWeight="Bold"/>
                    <TextBox Text="{Binding MagicalBonus, Mode=TwoWay}" Padding="5" Margin="0,0,0,15"/>
                </StackPanel>

                <!-- Artifact properties -->
                <StackPanel Visibility="{Binding IsArtifact, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Свойства артефакта" FontSize="14" FontWeight="Bold" Foreground="#9B59B6" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Сила:" FontWeight="Bold"/>
                    <TextBox Text="{Binding Power, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" Height="60" Padding="5" Margin="0,0,0,10"/>

                    <TextBlock Text="Редкость (1-5):" FontWeight="Bold"/>
                    <TextBox Text="{Binding Rarity, Mode=TwoWay}" Padding="5" Margin="0,0,0,15"/>
                </StackPanel>

                <!-- Trinket properties -->
                <StackPanel Visibility="{Binding IsTrinket, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Свойства безделушки" FontSize="14" FontWeight="Bold" Foreground="#F39C12" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Эффект:" FontWeight="Bold"/>
                    <TextBox Text="{Binding Effect, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" Height="60" Padding="5" Margin="0,0,0,10"/>

                    <TextBlock Text="Редкость:" FontWeight="Bold"/>
                    <TextBox Text="{Binding TrinketRarity, Mode=TwoWay}" Padding="5" Margin="0,0,0,15"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <UniformGrid Grid.Row="1" Columns="2" Margin="0,15,0,0">
            <Button Content="Сохранить" Click="SaveButton_Click" Height="40" Background="#2ECC71" Foreground="White" FontWeight="Bold" Margin="0,0,5,0"/>
            <Button Content="Отмена" Click="CancelButton_Click" Height="40" Background="#E74C3C" Foreground="White" FontWeight="Bold" Margin="5,0,0,0"/>
        </UniformGrid>
    </Grid>
</Window>
