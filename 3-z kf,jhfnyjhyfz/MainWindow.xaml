<Window x:Class="DndAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Помощник Ведущего (DnD)" Height="600" Width="450" Background="#F0F0F0">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>    </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Дневник Мастера" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>
            
            <TextBlock Text="Поиск героя по имени:" FontSize="12" Foreground="Gray"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Padding="5" Margin="0,5,0,10"/>

            <UniformGrid Columns="3">
                <Button Content="Создать героя"
                        Command="{Binding AddCharacterCommand}"
                        Margin="0,0,5,0" Height="35" Background="#3498DB" Foreground="White" FontWeight="Bold"/>
                <Button Content="Сохранить в файл"
                        Command="{Binding SaveCommand}"
                        Margin="5,0,5,0" Height="35" Background="#2ECC71" Foreground="White" FontWeight="Bold"/>
                <Button Content="Загрузить из файла"
                        Command="{Binding LoadCommand}"
                        Margin="5,0,0,0" Height="35" Background="#F39C12" Foreground="White" FontWeight="Bold"/>
            </UniformGrid>
        </StackPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding FilteredCharacters}" 
                 Background="Transparent" BorderThickness="0" 
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="8" Margin="0,0,0,10" Padding="15">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.2"/>
                        </Border.Effect>
                        
                        <StackPanel>
                            <TextBlock Text="{Binding ChName}" FontSize="18" FontWeight="Bold" Foreground="#E67E22"/>

                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="Раса: " FontWeight="Bold"/>
                                <TextBox Text="{Binding ChRace, Mode=TwoWay}" BorderThickness="0" Background="Transparent"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Локация: " FontWeight="Bold"/>
                                <TextBox Text="{Binding Location.Name, Mode=TwoWay}" BorderThickness="0" Background="Transparent" Foreground="#2980B9"/>
                            </StackPanel>

                            <TextBlock Text="Описание:" FontWeight="Bold" Margin="0,5,0,2"/>
                            <TextBox Text="{Binding ChDescription, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True"
                                     Background="#F9F9F9" BorderThickness="1" BorderBrush="#EEEEEE" Padding="5"/>

                            <TextBlock Text="Инвентарь:" FontWeight="Bold" Margin="0,10,0,2"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Медь:" FontWeight="Bold"/>
                                    <TextBox Text="{Binding Inventory.Copper, Mode=TwoWay}" Foreground="#A04000" FontWeight="SemiBold" BorderThickness="0" Background="Transparent"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Серебро:" FontWeight="Bold"/>
                                    <TextBox Text="{Binding Inventory.Silver, Mode=TwoWay}" Foreground="#3498DB" FontWeight="SemiBold" BorderThickness="0" Background="Transparent"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Золото:" FontWeight="Bold"/>
                                    <TextBox Text="{Binding Inventory.Gold, Mode=TwoWay}" Foreground="#27AE60" FontWeight="SemiBold" BorderThickness="0" Background="Transparent"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Предметы:" FontWeight="Bold" Margin="0,8,0,2"/>
                            <ItemsControl ItemsSource="{Binding Inventory.Items}" Margin="0,0,0,5">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#2C3E50" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Button Content="Редактировать" Height="24" Background="#3498DB" Foreground="White" FontSize="11" 
                                                    Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                    CommandParameter="{Binding}" Padding="8,2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Добавить предмет:" FontWeight="Bold" Margin="0,8,0,2"/>
                            <UniformGrid Columns="2" Rows="2" Margin="0,0,0,5">
                                <Button Content="Оружие" Command="{Binding DataContext.AddWeaponCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,5,5" Height="30" Background="#3498DB" Foreground="White"/>
                                <Button Content="Броня" Command="{Binding DataContext.AddArmorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="5,0,0,5" Height="30" Background="#2ECC71" Foreground="White"/>
                                <Button Content="Артефакт" Command="{Binding DataContext.AddArtifactCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,5,0" Height="30" Background="#9B59B6" Foreground="White"/>
                                <Button Content="Безделушка" Command="{Binding DataContext.AddTrinketCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="5,0,0,0" Height="30" Background="#F39C12" Foreground="White"/>
                            </UniformGrid>

                            <TextBlock Text="Действия:" FontWeight="Bold" Margin="0,8,0,2"/>
                            <Button Content="Удалить персонажа" Command="{Binding DataContext.RemoveCharacterCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" 
                                    Margin="0,0,0,5" Height="35" Background="#E74C3C" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
